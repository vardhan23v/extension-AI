PORT=5050
NODE_ENV=development

# Supabase (Project Settings → API). The service-role key is server-only — never expose it to the frontend.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Comma-separated allowed browser origins in production, e.g. https://extension-ai-five.vercel.app
CORS_ORIGINS=

# AI providers (at least one). Tried in this order: Groq → Gemini → OpenRouter.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GEMINI_API_KEY=
OPENROUTER_API_KEY=
AI_TIMEOUT_MS=90000

# Agent crew (Planner → Engineer → QA Reviewer → Security Analyst)
CREW_ENABLED=true
CREW_BUDGET_MS=50000
GROQ_FAST_MODEL=openai/gpt-oss-20b
AI_RATE_LIMIT=30


# Bring-your-own AI keys: 32 random bytes, base64. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
BYOK_ENCRYPTION_KEY=
AI_RATE_LIMIT_BYOK=200

# Testing Lab (GitHub Actions runner) — see README "Testing Lab setup"
TEST_RUNNER_SECRET=
TEST_RUNNER_REPO=
GITHUB_DISPATCH_TOKEN=
TEST_RUNS_PER_HOUR=10
